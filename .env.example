# Spendly AI — environment variables.
# Copy to `.env` (repository root or apps/api). Real environment variables always win over this file.
# Nothing here is required in development: every value has a safe local default.

# ── server ───────────────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# The public address of the web app. Used for CORS and for the CSRF origin check.
# Several origins can be listed in CORS_ORIGINS, comma-separated.
APP_ORIGIN=http://localhost:5173
# CORS_ORIGINS=

# ── database ─────────────────────────────────────────────────────────────────────────────────────
# `npm run dev` starts a local MongoDB for you on this port. In production use MongoDB Atlas or the
# docker-compose service.
MONGODB_URI=mongodb://127.0.0.1:27017/spendly

# ── sessions and transport security ──────────────────────────────────────────────────────────────
# REQUIRED in production: at least 32 random characters (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Defaults to true in production. Set to false only for plain-http testing on localhost.
# COOKIE_SECURE=true
# Number of reverse proxies in front of the API ("1" behind one load balancer), or "loopback".
TRUST_PROXY=0
# Redirect http:// to https:// (needs TRUST_PROXY so the original protocol is known).
FORCE_HTTPS=false

# ── sign-in codes (SMS) ──────────────────────────────────────────────────────────────────────────
# People sign in with a code texted to their mobile number (+91). SMS_PROVIDER chooses delivery:
#   console  — development only: no SMS is sent; the code is printed in the API log and shown on the
#              sign-in screen, labelled "Development mode". Refused when NODE_ENV=production.
#   twilio   — Twilio Messages API (fill in the TWILIO_* values below)
#   webhook  — POSTs { to, code, text } to a gateway you run (SMS_WEBHOOK_URL): MSG91, Fast2SMS, …
#   none     — code sign-in is unavailable; the demo workspace still works
# Unset means `console` in development and `none` in production.
# SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=                    # a number you own, e.g. +1…  (or use the messaging service below)
# TWILIO_MESSAGING_SERVICE_SID=
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_SECRET=             # sent as "Authorization: Bearer <secret>"
# OTP_TTL_MINUTES=5               # how long a code stays valid
# OTP_RESEND_SECONDS=30           # minimum gap before another code goes to the same number
# OTP_MAX_ATTEMPTS=5              # wrong tries before a code is cancelled
# OTP_MAX_SENDS_PER_HOUR=5        # codes per number per hour
# SMS_TIMEOUT_MS=10000

# ── uploads ──────────────────────────────────────────────────────────────────────────────────────
# Imported statements and receipts are stored here. Mount a persistent volume in production.
UPLOAD_DIR=.data/uploads
MAX_UPLOAD_MB=10

# ── background work and demo data ────────────────────────────────────────────────────────────────
# The import worker runs inside the API process. Set to false to run it elsewhere.
WORKER_ENABLED=true
# Demo workspaces (clearly labelled sample data) are deleted after this many hours.
DEMO_TTL_HOURS=24
# Where the built web app is served from. Found automatically in a normal checkout.
# WEB_DIST=

# ── AI (optional) ────────────────────────────────────────────────────────────────────────────────
# Spendly works fully without AI. A provider only rewords answers, helps classify merchants the
# rules cannot place, and reads receipt photos — and only for users who switch those on.
# See docs/PRIVACY.md for exactly what is sent.
#   none       — AI is off (default)
#   anthropic  — official Claude SDK
#   openai     — any OpenAI-compatible chat API (also set AI_BASE_URL for other vendors / local models)
AI_PROVIDER=none
# AI_MODEL=claude-opus-5-5
# AI_API_KEY=
# AI_BASE_URL=
# AI_VISION=false   # set to false for an endpoint that cannot read images, so receipt photos are not sent to it
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=4000
#
# Free hosted models from NVIDIA (https://build.nvidia.com), through its OpenAI-compatible endpoint. Create a free API
# key there (it needs an NVIDIA developer account) and put it in AI_API_KEY in your own .env — never in the repo. Choose a
# model that carries the "Free Endpoint" tag on build.nvidia.com; the free tier is rate limited (about 40 requests a minute
# at the time of writing), and reasoning models can be slow, so give them more time.
# AI_PROVIDER=openai
# AI_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b   # a vision-language model, so receipt photos work too
# AI_VISION=true                                    # false for a text-only model
# AI_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}   # optional: skip the model's long "thinking" for faster answers
# AI_TIMEOUT_MS=60000

# ── optional connectors (not implemented; see docs/INTEGRATIONS.md) ──────────────────────────────
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
