{
  "name": "@spendly/api",
  "version": "1.0.0",
  "private": true,
  "description": "Spendly AI REST API \u2014 Express 5, MongoDB/Mongoose, background import worker, provider-independent AI service.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "db": "tsx scripts/dev-db.ts",
